{
  "name": "zerodebtplan-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "ZeroDebtPlan phone app (Android / iOS) built with Capacitor from the same code as the web app.",
  "scripts": {
    "www": "node build-www.js",
    "sync": "node build-www.js && cap sync",
    "android": "node build-www.js && cap sync android && cd android && ./gradlew assembleDebug",
    "open:android": "cap open android",
    "open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/ios": "8.5.2",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@fontsource/inter": "5.3.0",
    "@fortawesome/fontawesome-free": "6.4.0",
    "chart.js": "4.4.1",
    "tailwindcss": "3.4.19"
  }
}
